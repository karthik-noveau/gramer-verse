[{"heading": "Types of Tense", "rows": [["PRESENT TENSE", "நிகழ்காலம்"], ["Simple present", "எளிய நிகழ்காலம்"], ["Present continuous", "தொடர்ந்து நிகழ்காலம்"], ["Present perfect", "சரியான நிகழ்காலம்"], ["Present perfect continuous", "சரியான தொடர்ச்சியான நிகழ்காலம்"], ["PAST TENSE", "கடந்த காலம்"], ["Simple past", "எளிய கடந்த காலம்"], ["Past continuous", "கடந்த தொடர்ச்சியான காலம்"], ["Past perfect", "முற்பட்ட கடந்த காலம்"], ["Past perfect continuous", "முற்பட்ட தொடர்ச்சியான கடந்த காலம்"]]}, {"heading": "Types of Tense", "rows": [["FUTURE TENSE", "எதிர்காலம்"], ["Simple future", "எளிய எதிர்காலம்"], ["Future continuous", "எதிர்கால தொடர்ச்சி"], ["Future perfect", "எதிர்கால பூர்த்தி"], ["Future perfect continuous", "எதிர்கால பூர்த்தி தொடர்ச்சி"]]}, {"heading": "( Helping verbs )", "rows": [["Auxiliary verb forms", "Present", "Past", "Future"], ["", "am,is,are", "Was,Were", "Will be,shall be"], ["Continuous", "am being,is being,are being", "Was being,were being", "Will be being,shall be being"], ["Perfect", "Has been,have been", "Had been", "Will have been,shall have been"], ["Perfect continuous", "Has been being,have been being", "Had been being", "Will have been being,shall have been being"]]}, {"heading": "Examples", "rows": [["Tense", "Auxiliary verb", "Usage example"], ["PRESENT TENSE", "", "", ""], ["Simple present", "am, is, are", "I am a writerHe is a writerThey are writers", "நான் ஒரு எழுத்தாளன்.அவன் ஒரு எழுத்தாளர்.அவர்கள் எழுத்தாளர்கள்."], ["Present continuous", "am being, is being, are being", "I am writing now..I am being careful in writingHe is being careful in writing", "நான் இப்போது எழுதுகிறேன்.அவன் எழுதுவதில் கவனமாக இருக்கிறான்.அவர்கள் எழுதுவதில் கவனமாக இருக்கிறார்கள்."], ["Present perfect", "has been, have been", "He has been writing for an hourThey have been writing", "அவன் ஒரு மணி நேரமாக எழுதிவருகிறான்.அவர்கள் எழுதிக்கொண்டிருக்கிறார்கள்."], ["Present perfect continuous", "Has been being, have been being", "He has been being careful in writing.They have been being careful in writing", "அவன் எழுதும் பொழுது கவனமாக இருந்து வந்தான்.அவர்கள் எழுதுவதில் கவனமாக இருந்து கொண்டிருக்கிறார்கள்."], ["PAST TENSE", "", "", ""], ["Simple past", "was, were", "I was a writer.They were writers.", "நான் ஒரு எழுத்தாளன் இருந்தேன்.அவர்கள் எழுத்தாளர்கள் இருந்தனர்."], ["Past continuous", "was being, were being", "I was writing yesterday.They were being careful in writing.", "நேற்று எழுதிக் கொண்டிருந்தேன்.அவர்கள் எழுதுவதில் கவனமாக இருந்தனர்."], ["Past perfect", "Had been", "I had been writing for an hour..", "நான் ஒரு மணி நேரமாக எழுதி வந்தேன்."], ["Past perfect continuous", "Had been being", "He had been being careful in writing.", "அவன் எழுதும் போது கவனமாக இருந்து வந்தான்."], ["FUTURE TENSE", "", "", ""], ["Simple future", "will be, shall be", "I will be a writer.We shall be writers.", "நான் ஒரு எழுத்தாளன் ஆக இருப்பேன்.நாங்கள் எழுத்தாளர்கள் ஆக இருப்போம்."], ["Future continuous", "will be being, shall be being", "I will be being careful while writingWe shall be being careful in writing.", "நான் எழுதும் போது கவனமாக இருந்து கொண்டிருப்பேன்.நாங்கள் எழுதுவதில் கவனமாக இருக்க இருப்போம்."], ["Future perfect", "will have been,shall have been", "I will have been writing for an hour.We shall have been writing.", "நான் ஒரு மணி நேரமாக எழுதி முடித்திருப்பேன்.நாங்கள் எழுதிக் கொண்டிருப்போம்."], ["Future perfect continuous", "will have been being, shall have been being", "I will have been being careful in writing.We shall have been being careful in writing.", "நான் எழுதும் போது கவனமாக இருந்து வந்திருப்பேன்.நாங்கள் எழுதுவதில் கவனமாக இருந்து கொண்டிருப்போம்."]]}, {"heading": "( Special helping verbs )", "rows": [["Modal Verb", "Tamil Meaning", "English Example", "Tamil Example"], ["can", "செய்ய முடியும்", "I can write.", "நான் எழுத முடியும்."], ["could", "முடிந்த செயல்", "I could go.", "நான் போக முடியும்."], ["will", "எதிர்காலம்", "I will write", "நான் எழுதப் போகிறேன்."], ["would", "கற்பனையான செயல் ( Imaginary action )", "I would like tea.", "நான் தேனீர் விரும்புகிறேன்."], ["may", "செயல் நிகழலாம்( செயல் நிகழ்வதற்கான சாத்தியங்கள் குறைவு )", "I may come", "நான் வர வாய்ப்பு இருக்கிறது"], ["might", "செயல் நிகழலாம்\n( செயல் நிகழ்வதற்கான சாத்தியங்கள் அதிகம் )", "It might rain today.", "இன்று மழை பெய்யலாம்"], ["must", "கட்டாயம் செய்ய வேண்டும்", "You must come.", "நீ வர வேண்டும்."], ["shall", "செய்யப்போகிறேன்( மரியாதையான )", "I shall help you", "நான் உங்களுக்கு உதவப்போகிறேன்."], ["should", "கட்டாயம் செய்ய வேண்டும்( மரியாதையான )", "You should study.", "நீ படிக்க வேண்டும்."], ["ought to", "செய்யவேண்டும் ( ஒழுக்கத்தை குறிக்கக்கூடிய செயல்", "You ought to help.", "நீ உதவ வேண்டும்."]]}, {"heading": "Main verb or Root verb", "rows": [["Root Verb", "Present", "Past", "Future", "Present Participle"], ["doசெய்", "do/doesசெய்கிறேன்", "didசெய்தேன்", "will do / shall doசெய்வேன்", "doingசெய்து கொண்டு"], ["readபடி", "read(s)படிக்கிறேன்", "readபடித்தேன்", "will read / shall readபடிப்பேன்", "readingபடித்து கொண்டு"], ["seeபார்", "see(s)பார்க்கிறேன்", "sawபார்த்தேன்", "will see / shall seeபார்ப்பேன்", "seeingபார்த்துக் கொண்டு"], ["askகேள்", "ask(s)கேட்கிறேன்", "askedகேட்டேன்", "will ask / shall askகேட்பேன்", "askingகேட்டுக் கொண்டு"], ["sleepதூங்கு", "sleep(s)தூங்குகிறேன்", "sleptதூங்கினேன்", "will sleep / shall sleepதூங்குவேன்", "sleepingதூங்கிக் கொண்டு"], ["sayசொல்", "say(s)சொல்கிறேன்", "saidசொன்னேன்", "will say / shall sayசொல்வேன்", "sayingசொல்லிக் கொண்டு"], ["tellசொல்", "tell(s)சொல்கிறேன்", "toldசொன்னேன்", "will tell / shall tellசொல்வேன்", "tellingசொல்லிக் கொண்டு"], ["listenகேள்", "listen(s)கேட்கிறேன்", "listenedகேட்டேன்", "will listen / shall listenகேட்பேன்", "listeningகேட்டுக் கொண்டு"], ["openதிற", "open(s)திறக்கிறேன்", "openedதிறந்தேன்", "will open / shall openதிறப்பேன்", "openingதிறந்து கொண்டு"], ["closeமூடு", "close(s)மூடுகிறேன்", "closedமூடினேன்", "will close / shall closeமூடுவேன்", "closingமூடிக் கொண்டு"], ["pullஇழு", "pull(s)இழுக்கிறேன்", "pulledஇழுத்தேன்", "will pull / shall pullஇழுப்பேன்", "pullingஇழுத்துக் கொண்டு"], ["bathகுளி", "bath